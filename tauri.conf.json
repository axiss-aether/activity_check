{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ритм",
  "version": "0.2.0",
  "identifier": "ru.ritm.activity",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Ритм — учёт активности",
        "width": 760,
        "height": 630,
        "minWidth": 640,
        "minHeight": 540,
        "decorations": false,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.ico"]
  }
}
